{
  "name": "teledentistry-express",
  "version": "1.0.0",
  "description": "ElysiaJS rewrite of the Teledentistry backend",
  "module": "src/server.ts",
  "scripts": {
    "build": "bun build ./src/server.ts --outdir ./dist --target bun --external '*'",
    "start": "bun run src/server.ts",
    "dev": "bun --watch src/server.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "bun --env-file=.env test --timeout=30000"
  },
  "dependencies": {
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "ws": "^8.18.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "handlebars": "^4.7.8",
    "aws-sdk": "^2.1692.0",
    "bcrypt": "^5.1.1",
    "socket.io": "^4.8.1",
    "elysia": "^1.4.29",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "bun-types": "^1.3.14",
    "eslint": "^9.17.0"
  },
  "license": "MIT"
}
